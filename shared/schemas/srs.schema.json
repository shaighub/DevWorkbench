{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devworkbench.local/schemas/srs.schema.json",
  "title": "SoftwareRequirementsSpecification",
  "description": "Machine-readable SRS handoff from the requirements agent to design, build, and test. The narrative outline follows ISO/IEC/IEEE 29148:2018 clause 9.6. Requirement objects conform to requirement.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "introduction",
    "references",
    "stakeholders",
    "needs",
    "scope",
    "requirements",
    "useCases",
    "userStories",
    "interfaces",
    "dataEntities",
    "glossary",
    "openQuestions",
    "qualityModelCoverage",
    "traceability",
    "approval"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "introduction": { "$ref": "#/$defs/introduction" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stakeholder" }
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/need" }
    },
    "scope": { "$ref": "#/$defs/scope" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "requirement.schema.json" }
    },
    "useCases": {
      "type": "array",
      "items": { "$ref": "#/$defs/useCase" }
    },
    "userStories": {
      "type": "array",
      "items": { "$ref": "#/$defs/userStory" }
    },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "dataEntities": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataEntity" }
    },
    "glossary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/glossaryEntry" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/openQuestion" }
    },
    "qualityModelCoverage": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/qualityCoverage" },
      "description": "One row for each of the nine ISO/IEC 25010:2023 product-quality characteristics."
    },
    "traceability": { "$ref": "#/$defs/traceability" },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "standard",
        "qualityModel",
        "priorityScheme",
        "acceptanceCriteriaNotation",
        "documentId",
        "title",
        "project",
        "version",
        "status",
        "engagementId",
        "preparedBy",
        "sourceDocument",
        "idPolicy"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0.0" },
        "standard": { "type": "string", "const": "ISO/IEC/IEEE 29148:2018" },
        "qualityModel": { "type": "string", "const": "ISO/IEC 25010:2023" },
        "priorityScheme": { "type": "string", "const": "MoSCoW" },
        "acceptanceCriteriaNotation": { "type": "string", "const": "Gherkin" },
        "documentId": { "type": "string", "pattern": "^SRS-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 5 },
        "project": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["draft", "proposed", "approved", "handed-off"] },
        "engagementId": { "type": "string", "minLength": 3 },
        "preparedBy": { "type": "string", "const": "requirements-agent" },
        "sourceDocument": { "type": "string", "minLength": 3 },
        "idPolicy": {
          "type": "string",
          "description": "States that identifiers are immutable after gate G4 and are never reused."
        }
      }
    },
    "introduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "scope",
        "productPerspective",
        "productFunctions",
        "userCharacteristics",
        "limitations"
      ],
      "properties": {
        "purpose": { "type": "string", "minLength": 20 },
        "scope": { "type": "string", "minLength": 20 },
        "productPerspective": { "type": "string", "minLength": 20 },
        "productFunctions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "userCharacteristics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "citation"],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "citation": { "type": "string", "minLength": 5 }
      }
    },
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "namedInSource",
        "interviewed",
        "concerns",
        "decisionRights",
        "interest",
        "influence",
        "interestIsJudgment"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^STK-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "namedInSource": { "type": "boolean" },
        "interviewed": { "type": "boolean" },
        "concerns": {
          "type": "array",
          "items": { "type": "string", "minLength": 5 }
        },
        "decisionRights": { "type": "string", "minLength": 5 },
        "interest": { "enum": ["high", "medium", "low", "unknown"] },
        "influence": { "enum": ["high", "medium", "low", "unknown"] },
        "interestIsJudgment": {
          "type": "boolean",
          "description": "True when interest or influence was judged by the analyst rather than stated by the stakeholder."
        }
      }
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "stakeholderIds", "priority", "citations", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^NEED-[0-9]{3}$" },
        "statement": {
          "type": "string",
          "minLength": 15,
          "description": "Stakeholder need in the sponsor's language. Not a shall statement."
        },
        "stakeholderIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^STK-[0-9]{3}$" }
        },
        "priority": { "enum": ["Must", "Should", "Could", "Won't"] },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "status": { "enum": ["proposed", "accepted", "rejected", "open"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope", "outOfScope", "assumptions", "dependencies", "constraints"],
      "properties": {
        "inScope": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scopeIn" }
        },
        "outOfScope": {
          "type": "array",
          "items": { "$ref": "#/$defs/scopeOut" }
        },
        "assumptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assumption" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        }
      }
    },
    "scopeIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "item", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^SC-IN-[0-9]{2}$" },
        "item": { "type": "string", "minLength": 5 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "scopeOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "item", "priority", "rationale", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^SC-OUT-[0-9]{2}$" },
        "item": { "type": "string", "minLength": 5 },
        "priority": { "const": "Won't" },
        "rationale": { "type": "string", "minLength": 10 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "ifFalse", "affects"],
      "properties": {
        "id": { "type": "string", "pattern": "^ASM-[0-9]{3}$" },
        "statement": { "type": "string", "minLength": 10 },
        "ifFalse": {
          "type": "string",
          "minLength": 10,
          "description": "What returns to intake when the assumption is false."
        },
        "affects": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^DEP-[0-9]{3}$" },
        "statement": { "type": "string", "minLength": 10 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^CON-[0-9]{3}$" },
        "statement": { "type": "string", "minLength": 10 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "primaryActorId",
        "level",
        "preconditions",
        "trigger",
        "mainSuccessScenario",
        "extensions",
        "requirementIds"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^UC-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 3 },
        "primaryActorId": { "type": "string", "pattern": "^STK-[0-9]{3}$" },
        "level": { "enum": ["summary", "user-goal", "subfunction"] },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trigger": { "type": "string", "minLength": 5 },
        "mainSuccessScenario": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "requirementIds"],
            "properties": {
              "step": { "type": "string", "minLength": 5 },
              "requirementIds": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" }
              }
            }
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition", "behavior", "requirementIds"],
            "properties": {
              "condition": { "type": "string", "minLength": 5 },
              "behavior": { "type": "string", "minLength": 5 },
              "requirementIds": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" }
              }
            }
          }
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" }
        }
      }
    },
    "userStory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asA", "iWant", "soThat", "requirementIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^US-[0-9]{3}$" },
        "asA": { "type": "string", "minLength": 2 },
        "iWant": { "type": "string", "minLength": 5 },
        "soThat": { "type": "string", "minLength": 5 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "direction",
        "externalParty",
        "purpose",
        "dataSent",
        "dataReceived",
        "errorBehavior",
        "representation",
        "requirementIds",
        "citations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^IF-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 3 },
        "kind": {
          "description": "ISO/IEC/IEEE 29148 external-interface class.",
          "enum": ["user", "software", "hardware", "communications"]
        },
        "direction": { "enum": ["inbound", "outbound", "bidirectional"] },
        "externalParty": { "type": "string", "minLength": 2 },
        "purpose": { "type": "string", "minLength": 10 },
        "dataSent": { "type": "array", "items": { "type": "string" } },
        "dataReceived": { "type": "array", "items": { "type": "string" } },
        "errorBehavior": { "type": "string", "minLength": 10 },
        "representation": {
          "type": "string",
          "minLength": 10,
          "description": "Business content only, unless the source mandated a representation. Otherwise state that representation is deferred to design."
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "dataEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "attributes", "requirementIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^ENT-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 2 },
        "description": { "type": "string", "minLength": 10 },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "meaning"],
            "properties": {
              "name": { "type": "string", "minLength": 2 },
              "meaning": { "type": "string", "minLength": 5 },
              "allowedValues": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" }
        }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition", "source"],
      "properties": {
        "term": { "type": "string", "minLength": 2 },
        "definition": { "type": "string", "minLength": 10 },
        "source": { "type": "string", "minLength": 3 }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "whyItMatters",
        "blocking",
        "mustNotBeInvented",
        "raisedBySkill",
        "status",
        "answerableBy",
        "citations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^OQ-[0-9]{3}$" },
        "question": { "type": "string", "minLength": 10 },
        "whyItMatters": { "type": "string", "minLength": 10 },
        "blocking": {
          "type": "boolean",
          "description": "True when a requested shall cannot be written unambiguously until this is answered."
        },
        "mustNotBeInvented": {
          "type": "string",
          "minLength": 10,
          "description": "The decision downstream agents are forbidden to make while this stays open."
        },
        "raisedBySkill": { "type": "string", "minLength": 2 },
        "status": { "enum": ["open", "answered", "accepted-residual"] },
        "answerableBy": { "type": "string", "minLength": 3 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "answer": { "type": "string" }
      }
    },
    "qualityCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characteristic", "disposition", "requirementIds", "openQuestionIds", "rationale"],
      "properties": {
        "characteristic": {
          "enum": [
            "functional-suitability",
            "performance-efficiency",
            "compatibility",
            "interaction-capability",
            "reliability",
            "security",
            "maintainability",
            "flexibility",
            "safety"
          ]
        },
        "disposition": {
          "enum": ["covered", "not-applicable", "open-question", "not-stated"]
        },
        "requirementIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" }
        },
        "openQuestionIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OQ-[0-9]{3}$" }
        },
        "rationale": { "type": "string", "minLength": 20 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "covered" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "requirementIds": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "open-question" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "openQuestionIds": { "minItems": 1 } }
          }
        }
      ]
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix",
        "idFreeze",
        "needsWithoutCoverage",
        "orphanRequirementIds",
        "requirementsMissingAcceptanceCriteria",
        "designColumn",
        "testColumn"
      ],
      "properties": {
        "matrix": { "type": "string" },
        "idFreeze": {
          "type": "boolean",
          "description": "True after G4. Consumers add columns; they do not renumber rows."
        },
        "needsWithoutCoverage": {
          "type": "array",
          "items": { "type": "string" }
        },
        "orphanRequirementIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirementsMissingAcceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "designColumn": {
          "type": "string",
          "description": "Who may write Design Element ID, and the rule that it stays blank until then."
        },
        "testColumn": {
          "type": "string",
          "description": "Who may write Test Case ID, and the rule that it stays blank until then."
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "gates",
        "residualOpenQuestionIds",
        "blockingOpenQuestionIds",
        "residualRiskAccepted",
        "consumers",
        "humanApproval"
      ],
      "properties": {
        "status": { "enum": ["draft", "proposed", "approved", "handed-off"] },
        "gates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "result", "notes"],
            "properties": {
              "id": { "enum": ["G1", "G2", "G3", "G4", "G5"] },
              "result": { "enum": ["pass", "fail", "ready", "not-run"] },
              "notes": { "type": "string", "minLength": 5 }
            }
          }
        },
        "residualOpenQuestionIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OQ-[0-9]{3}$" }
        },
        "blockingOpenQuestionIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OQ-[0-9]{3}$" }
        },
        "residualRiskAccepted": {
          "type": "boolean",
          "description": "True only after a named human accepts shipping with open questions still unanswered."
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["design", "build", "test"] }
        },
        "humanApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recorded", "note"],
          "properties": {
            "recorded": { "type": "boolean" },
            "approver": { "type": "string" },
            "note": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
